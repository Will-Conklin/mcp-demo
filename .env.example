# TinyDB MCP Server Configuration
# Copy this file to .env and customize as needed

# Database Settings
TINYDB_PATH=tinydb_data.json

# Logging Settings
LOG_LEVEL=INFO
ENABLE_LOGFIRE=false
# LOGFIRE_TOKEN=your_logfire_api_token_here

# Server Settings
SERVER_NAME=TinyDB MCP Server
SERVER_VERSION=0.1.0
